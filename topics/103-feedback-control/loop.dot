digraph loop {
 graph [rankdir=LR, bgcolor="white", pad=0.3, label="Topic 103: delayed capacity feedback (one tick = 10 seconds)", labelloc=t, fontsize=20];
 node [shape=box, style="rounded,filled", fillcolor="#e7f0fb", fontname="Helvetica", fontsize=13];
 load [label="Offered arrivals\n6,000 -> 12,000 / tick"];
 plant [label="Ready replicas + queue\n1,000 requests / replica / tick"];
 sensor [label="Measurement delay\n2 ticks (20 seconds)"];
 control [label="Controller\nTarget: 600 arrivals / replica / tick\nGain: 1 or 1/8"];
 actuator [label="Absolute replica command\nceil + clamp [1, 40]\nReady after 3 ticks"];
 load -> plant; plant -> sensor [label="Ready count"];
 load -> sensor [label="arrival count"];
 sensor -> control; control -> actuator; actuator -> plant [label="useful capacity"];
}
